includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - tests
    level: 8
    ignoreErrors:
        # Pest scaffolded helpers use dynamic binding ($this in closures)
        - '#Undefined variable: \$this#'
        # Pest scaffolded helper function intentionally has no return type
        - '#Function something\(\) has no return type specified#'
        # Laravel scaffolded User model uses HasFactory without generic type
        - '#Class App\\Models\\User uses generic trait .* but does not specify its types#'
        # Pest/Laravel test methods (withHeaders, etc.) not detected by PHPStan in test context
        - '#Call to an undefined method PHPUnit\\Framework\\TestCase::(withHeaders|get|getJson|postJson)#'
    excludePaths:
        - app/Console/Kernel.php
